{
  "name": "payflow-core",
  "version": "1.0.0",
  "description": "High-Performance Payment Gateway & Immutable Double-Entry Ledger Core Platform",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "db:push": "bunx prisma db push",
    "db:generate": "bunx prisma generate",
    "db:seed": "bun run src/infrastructure/database/seed.ts",
    "check-arch": "bun run scripts/arch_lint.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "prisma": "^6.4.1",
    "typescript": "^5.7.3"
  }
}
