{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "PayFlow Core Financial Design Tokens",
  "version": "1.0.0",
  "description": "Standardized financial and ledger design tokens for high-density transactional monitoring, WCAG 2.1 AAA accessibility.",
  "tokens": {
    "color": {
      "brand": {
        "primary": { "value": "#4F46E5", "description": "Indigo primary brand. Contrast ratio >= 4.5:1 on light/dark." },
        "primary-hover": { "value": "#4338CA", "description": "Indigo hover state." },
        "primary-active": { "value": "#3730A3", "description": "Indigo pressed state." },
        "secondary": { "value": "#0D9488", "description": "Teal secondary accent for balance ledgers." }
      },
      "neutral": {
        "bg-canvas": { "value": "#090D16", "description": "Dark midnight financial canvas background." },
        "bg-surface": { "value": "#111827", "description": "Card, table row, and modal surface." },
        "bg-subtle": { "value": "#1F2937", "description": "Subtle borders, dividers and active rows." },
        "text-primary": { "value": "#F9FAFB", "description": "Maximum-contrast body and currency values (WCAG AAA)." },
        "text-secondary": { "value": "#9CA3AF", "description": "Labels, account codes, and metadata." },
        "text-muted": { "value": "#6B7280", "description": "Disabled buttons and timestamp footnotes." }
      },
      "semantic": {
        "credit": { "value": "#10B981", "description": "Credit entries and paid charges (Emerald green)." },
        "debit": { "value": "#F59E0B", "description": "Debit entries and settlement reserves (Amber)." },
        "error": { "value": "#EF4444", "description": "Failed transactions, unbalanced ledgers, signature errors." },
        "info": { "value": "#06B6D4", "description": "Pending webhooks, audit info, idempotency hits." }
      }
    },
    "typography": {
      "fontFamily": {
        "sans": { "value": ["Inter", "system-ui", "-apple-system", "sans-serif"] },
        "mono": { "value": ["JetBrains Mono", "Fira Code", "ui-monospace", "monospace"] }
      },
      "fontSize": {
        "xs": { "value": "0.75rem", "lineHeight": "1rem" },
        "sm": { "value": "0.875rem", "lineHeight": "1.25rem" },
        "base": { "value": "1rem", "lineHeight": "1.5rem" },
        "lg": { "value": "1.125rem", "lineHeight": "1.75rem" },
        "xl": { "value": "1.25rem", "lineHeight": "1.75rem" },
        "2xl": { "value": "1.5rem", "lineHeight": "2rem" },
        "3xl": { "value": "1.875rem", "lineHeight": "2.25rem" }
      },
      "fontWeight": {
        "regular": { "value": 400 },
        "medium": { "value": 500 },
        "semibold": { "value": 600 },
        "bold": { "value": 700 }
      }
    },
    "spacing": {
      "scale": "8px base grid",
      "0": { "value": "0px" },
      "1": { "value": "4px" },
      "2": { "value": "8px" },
      "3": { "value": "12px" },
      "4": { "value": "16px" },
      "6": { "value": "24px" },
      "8": { "value": "32px" },
      "12": { "value": "48px" },
      "16": { "value": "64px" }
    },
    "borderRadius": {
      "none": { "value": "0px" },
      "sm": { "value": "4px" },
      "md": { "value": "8px" },
      "lg": { "value": "12px" },
      "full": { "value": "9999px" }
    },
    "elevation": {
      "sm": { "value": "0 1px 2px 0 rgba(0, 0, 0, 0.4)" },
      "md": { "value": "0 4px 6px -1px rgba(0, 0, 0, 0.5), 0 2px 4px -1px rgba(0, 0, 0, 0.3)" },
      "lg": { "value": "0 10px 15px -3px rgba(0, 0, 0, 0.6), 0 4px 6px -2px rgba(0, 0, 0, 0.4)" }
    }
  }
}
